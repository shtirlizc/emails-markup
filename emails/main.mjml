    <!-- ============== EVENTS ============== -->
    <mj-wrapper background-color="#9261ff" border-radius="24px" padding="12px 24px 24px 24px" css-class="events">
      <mj-section padding="0 0 16px 0">
        <mj-column width="62%" vertical-align="top">
          <mj-text font-size="36px" font-weight="bold" line-height="1" color="#ffffff" padding="12px 0 24px 2px">
            События<br/>Сферы
          </mj-text>
          <mj-text font-size="16px" line-height="1.35" color="#ffffff" padding="0 0 0 2px" css-class="text-nowrap">
            Встречаем лето с классными событиями июня.
          </mj-text>
        </mj-column>
        <mj-column width="38%" vertical-align="middle" css-class="events-illu-column">
          <mj-image src="../assets/events-illu.png" alt="" width="165px" height="169px" align="right" padding="0" />
        </mj-column>
      </mj-section>

      <mj-section padding="0 0 16px 0">
        <mj-column width="50%" vertical-align="top" padding="0 8px 0 0" css-class="event-card-left">
          <mj-text padding="0">
            <table cellpadding="0" cellspacing="0" role="presentation" width="100%" style="background:#ffffff;border-radius:16px;">
            <tr>
              <td class="event-card-content" style="padding:20px 20px 18px 20px;font-family:Arial,Helvetica,sans-serif;color:rgba(0,0,0,0.8);">
                <p style="margin:0 0 9px 0;font-size:16px;font-weight:bold;line-height:1.2;">Поговорим Про × Сфера: когда риск (не) оправдан</p>
                <p style="margin:0 0 12px 0;font-size:12px;line-height:1.2;">3 июня 17:00–18:30</p>
                <p style="margin:0 0 30px 0;font-size:12px;line-height:1.2;">В новом выпуске Поговорим про × «Сфера» обсудим решения без полной ясности, ответственность, давление, ошибки и всё то, что обычно остаётся за&nbsp;кадром красивых запусков.</p>
                <a class="event-card-cta" href="#TODO-event-1" style="display:inline-block;background:#222a3a;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;line-height:1;text-decoration:none;border-radius:40px;padding:15px 24px;">Записаться</a>
              </td>
            </tr>
            </table>
          </mj-text>
        </mj-column>
        <mj-column width="50%" vertical-align="top" padding="0 0 0 8px" css-class="event-card-right">
          <mj-text padding="0">
            <table cellpadding="0" cellspacing="0" role="presentation" width="100%" style="background:#ffffff;border-radius:16px;">
            <tr>
              <td class="event-card-content" style="padding:20px 20px 18px 20px;font-family:Arial,Helvetica,sans-serif;color:rgba(0,0,0,0.8);">
                <p style="margin:0 0 9px 0;font-size:16px;font-weight:bold;line-height:1.2;">Какие мы:<br>портрет яндексоида</p>
                <p style="margin:0 0 12px 0;font-size:12px;line-height:1.2;">10 июня 16:00–17:30</p>
                <p style="margin:0 0 30px 0;font-size:12px;line-height:1.2;">Как мы взаимодействуем, что нас мотивирует, чем мы похожи друг на&nbsp;друга и чем отличаемся от других компаний — разберёмся на встрече, основываясь на исследовании Zetic.</p>
                <a class="event-card-cta" href="#TODO-event-2" style="display:inline-block;background:#222a3a;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;line-height:1;text-decoration:none;border-radius:40px;padding:15px 24px;">Записаться</a>
              </td>
            </tr>
            </table>
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="0">
        <mj-column width="50%" vertical-align="top" padding="0 8px 0 0" css-class="event-card-left">
          <mj-text padding="0">
            <table cellpadding="0" cellspacing="0" role="presentation" width="100%" style="background:#ffffff;border-radius:16px;">
              <tr>
                <td class="event-card-content" style="padding:20px 20px 18px 20px;font-family:Arial,Helvetica,sans-serif;color:rgba(0,0,0,0.8);">
                  <p style="margin:0 0 9px 0;font-size:16px;font-weight:bold;line-height:1.2;">Teamlead Community Day в&nbsp;Питере</p>
                  <p style="margin:0 0 12px 0;font-size:12px;line-height:1.2;">16 июня 19:00</p>
                  <p style="margin:0 0 14px 0;font-size:12px;line-height:1.2;">Внутренняя встреча комьюнити тимлидов Яндекса: знакомимся, общаемся и обсуждаем профессиональные темы. Приходите,&nbsp;если окажетесь в Питере!</p>
                  <a class="event-card-cta" href="#TODO-event-3" style="display:inline-block;background:#222a3a;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;line-height:1;text-decoration:none;border-radius:40px;padding:15px 24px;">БЦ Феррум, Epochs</a>
                </td>
              </tr>
            </table>
          </mj-text>
        </mj-column>
        <mj-column width="50%" vertical-align="top" padding="0 0 0 8px" css-class="event-card-right">
          <mj-text padding="0">
            <table cellpadding="0" cellspacing="0" role="presentation" width="100%" style="background:#ffffff;border-radius:16px;">
              <tr>
                <td class="event-card-content" style="padding:20px 20px 18px 20px;font-family:Arial,Helvetica,sans-serif;color:rgba(0,0,0,0.8);">
                  <p style="margin:0 0 9px 0;font-size:16px;font-weight:bold;line-height:1.2;">Дискуссионный клуб руководителей Яндекса</p>
                  <p style="margin:0 0 12px 0;font-size:12px;line-height:1.2;">26 июня 16:30–18:00</p>
                  <p style="margin:0 0 14px 0;font-size:12px;line-height:1.2;">Первая летняя встреча участников «Сферы», куда можно принести любой вопрос — или просто послушать, с&nbsp;чем&nbsp;сейчас сталкиваются коллеги из&nbsp;разных команд Яндекса.</p>
                  <a class="event-card-cta" href="#TODO-event-4" style="display:inline-block;background:#222a3a;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;line-height:1;text-decoration:none;border-radius:40px;padding:15px 24px;">Записаться</a>
                </td>
              </tr>
            </table>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

