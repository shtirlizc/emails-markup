          </mj-table>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-wrapper padding="0 26px 16px 30px">
      <mj-section
        background-color="#e8f2ff"
        border-radius="18px"
        padding="18px 18px 20px"
      >
        <mj-column>
          <mj-table
            table-layout="fixed"
            font-size="16px"
            line-height="20px"
          >
            <tr>
              <td
                width="42"
                valign="top"
                style="width: 42px; padding: 0"
              >
                <div
                  style="
                    width: 42px;
                    background-color: #c2f56b;
                    border-radius: 21px;
                    color: #055708;
                    font-size: 13px;
                    font-weight: bold;
                    line-height: 42px;
                    text-align: center;
                  "
                >
