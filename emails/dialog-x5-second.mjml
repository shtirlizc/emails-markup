          width="172px"
          height="132px"
          border="2px solid #E5EBEB"
          border-radius="16px"
          padding="0 0 6px"
        />
        <mj-text
          align="center"
          font-size="13px"
          font-weight="bold"
          line-height="16.25px"
          padding="4.875px 0"
          >Ольга Шипилова</mj-text
        >
        <mj-text
          align="center"
          color="#5c6166"
          font-size="12px"
          line-height="15px"
          >X5 Digital</mj-text
        >
      </mj-column>
      <mj-column
        css-class="dialog-second-speaker-three"
        width="33.333333%"
        padding="0 6px 18px"
      >
        <mj-image
          css-class="dialog-second-fluid-image dialog-second-small-photo"
          src="../img/gavrilov-card.png"
          alt="Алексей Гаврилов"
          width="172px"
          height="132px"
          border="2px solid #E5EBEB"
          border-radius="16px"
          padding="0 0 6px"
        />
        <mj-text
          align="center"
          font-size="13px"
          font-weight="bold"
          line-height="16.25px"
          padding="4.875px 0"
          >Алексей Гаврилов</mj-text
        >
        <mj-text
          align="center"
          color="#5c6166"
          font-size="12px"
          line-height="15px"
          >Пятёрочка</mj-text
        >
      </mj-column>
    </mj-section>

    <mj-section padding="16px 30px">
      <mj-column
        ><mj-text
          font-size="22px"
          font-weight="bold"
          line-height="28px"
          >Три кейса, которые можно забрать в работу</mj-text
        ></mj-column
      >
    </mj-section>

    <mj-wrapper padding="0 26px 16px 30px">
      <mj-section
        background-color="#e8f2ff"
        border-radius="18px"
        padding="18px 18px 19px"
      >
        <mj-column>
          <mj-table
            table-layout="fixed"
            font-size="16px"
            line-height="20px"
          >
            <tr>
              <td
                width="42"
                valign="top"
                style="width: 42px; padding: 0"
              >
                <div
                  style="
                    width: 42px;
                    background-color: #c2f56b;
                    border-radius: 21px;
                    color: #055708;
                    font-size: 13px;
                    font-weight: bold;
                    line-height: 42px;
                    text-align: center;
                  "
                >
                  01
                </div>
              </td>
              <td
                valign="top"
                style="padding: 0 0 0 16px"
              >
                <div
                  style="
                    font-size: 18px;
                    font-weight: bold;
                    line-height: 23px;
                    margin: 0 0 4px;
                  "
                >
                  EVYAP · ARKO и DURU
                </div>
                <div style="max-width: 315.633px">
                  От гипотез к полке: как превратить цифры в покупательский
                  спрос
                </div>
              </td>
            </tr>
          </mj-table>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-wrapper padding="0 26px 16px 30px">
      <mj-section
